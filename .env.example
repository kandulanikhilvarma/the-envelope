# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="replace-me"

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# No price ids: amounts are built from src/lib/pricing.ts at checkout, so the
# price the customer is charged and the VAT recorded against the order can
# never drift apart.

# ── Email (Resend) ───────────────────────────────────────────────────
# Two transactional messages: the confirmation carrying the cancel token,
# and the notice a week before a letter is posted. Unset in development
# means both are logged and skipped, never an error.
RESEND_API_KEY=""
EMAIL_FROM="The Envelope <hello@your-domain.example>"
# Where dispatch failures and an overdue backlog are reported. Unset means
# those only reach the logs, which nobody reads at 6am.
OPERATOR_EMAIL=""

# ── Pingen (print + mail) ────────────────────────────────────────────
PINGEN_CLIENT_ID="replace-me"
PINGEN_CLIENT_SECRET="replace-me"
PINGEN_ORGANISATION_ID="replace-me"
# Use Pingen's staging environment until the live test letter is confirmed.
PINGEN_API_BASE="https://api-staging.pingen.com"

# ── Letter encryption ────────────────────────────────────────────────
# A KEYRING, not a single key. Letters must still decrypt up to 5 years
# after they were written, so keys rotate ADDITIVELY: add a new version,
# bump ACTIVE_VERSION, and keep every old version here forever. Dropping
# an old version permanently destroys every letter encrypted under it.
# Keep an offline escrow copy of this value.
# Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Format: {"<version>":"<base64 32-byte key>"}
LETTER_ENCRYPTION_KEYRING='{"1":"replace-with-base64-32-byte-key"}'
LETTER_ENCRYPTION_ACTIVE_VERSION="1"

# ── Dispatch worker ──────────────────────────────────────────────────
# Shared secret the scheduler sends so the cron route cannot be invoked
# by anyone who finds the URL. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="replace-me"

# ── Feature flags ────────────────────────────────────────────────────
ENABLE_AI_DRAFT="false"
