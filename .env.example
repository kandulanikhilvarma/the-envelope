# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="replace-me"

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PRICE_SINGLE="price_replace_me"   # EUR 19
STRIPE_PRICE_PAIR="price_replace_me"     # EUR 29

# ── Pingen (print + mail) ────────────────────────────────────────────
PINGEN_CLIENT_ID="replace-me"
PINGEN_CLIENT_SECRET="replace-me"
PINGEN_ORGANISATION_ID="replace-me"
# Use Pingen's staging environment until the live test letter is confirmed.
PINGEN_API_BASE="https://api-staging.pingen.com"

# ── Letter encryption ────────────────────────────────────────────────
# A KEYRING, not a single key. Letters must still decrypt up to 5 years
# after they were written, so keys rotate ADDITIVELY: add a new version,
# bump ACTIVE_VERSION, and keep every old version here forever. Dropping
# an old version permanently destroys every letter encrypted under it.
# Keep an offline escrow copy of this value.
# Format: {"<version>":"<base64 32-byte key>"}
LETTER_ENCRYPTION_KEYRING='{"1":"replace-with-base64-32-byte-key"}'
LETTER_ENCRYPTION_ACTIVE_VERSION="1"

# ── Dispatch worker ──────────────────────────────────────────────────
# Shared secret the scheduler sends so the cron route cannot be invoked
# by anyone who finds the URL.
CRON_SECRET="replace-me"

# ── Feature flags ────────────────────────────────────────────────────
ENABLE_AI_DRAFT="false"
